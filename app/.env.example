# Mhuri Hub — environment contract
# Copy to `.env` and fill in before running in live mode.
# Without this file (or with APP_ENV=demo) the app runs in offline demo mode:
# seeded family, no network calls, no accounts needed.

APP_ENV=demo

# ── Supabase (required for APP_ENV=live) ────────────────────────────────────
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Push notifications (Firebase Cloud Messaging) — kid requests, approvals
# FCM_PROJECT_ID=
# Error reporting
# SENTRY_DSN=
# FX rate source override (default: bundled RBZ daily snapshot)
# RATE_API_URL=
