# Mhuri Hub — server connection config
# The app has NO demo mode: it always connects to your family's Supabase
# project. This file is one of three ways to give it the connection:
#
#   1. (simplest) paste your values into kSupabaseUrl / kSupabaseAnonKey
#      in lib/core/config/app_env.dart — they are public-by-design.
#   2. build with:
#        --dart-define=MHURI_SUPABASE_URL=… --dart-define=MHURI_SUPABASE_ANON_KEY=…
#   3. copy this file to .env, fill it in, and uncomment the `- .env` line
#      under `assets:` in pubspec.yaml.
#
# A build with none of these shows a setup error screen at startup.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Push notifications (Firebase Cloud Messaging) — kid requests, approvals
# FCM_PROJECT_ID=
# Error reporting
# SENTRY_DSN=
# FX rate source override (default: bundled RBZ daily snapshot)
# RATE_API_URL=
