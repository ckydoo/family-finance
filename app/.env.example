# Mhuri Hub — copy to app/.env (gitignored) and fill in.
# Which environment this build targets: dev | staging | prod.
# Override at build time: --dart-define=MHURI_ENV=staging
# A prod build pointing at a staging URL refuses to start (#17 guard).
ENV=dev

# The family's Supabase project (Project Settings → API).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional, reserved for later milestones:
SENTRY_DSN=
FCM_PROJECT_ID=
RATE_API_URL=
