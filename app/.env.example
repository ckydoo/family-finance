# Mhuri Hub — server connection config
# The app has NO demo mode: it always connects to your family's Supabase
# project. For local development, copy this file to `.env` and fill in the
# values below. Flutter bundles that ignored file as an application asset.
#
# CI/release builds may instead use:
#        --dart-define=MHURI_SUPABASE_URL=… --dart-define=MHURI_SUPABASE_ANON_KEY=…
#
# Never place a Supabase service-role key here. Mobile application assets can
# be extracted; the anon/publishable key must be protected by server-side RLS.
# A build with neither source shows a setup error screen at startup.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Push notifications (Firebase Cloud Messaging) — kid requests, approvals
# FCM_PROJECT_ID=
# Error reporting
# SENTRY_DSN=
# FX rate source override (default: bundled RBZ daily snapshot)
# RATE_API_URL=
